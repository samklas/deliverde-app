{
  "cli": {
    "version": ">= 16.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "staging": {                                                                                                                                             
      "distribution": "store",                                                                                                                        
      "autoIncrement": true,       
      "environment": "development"                                                                                                                           
       }, 
    "production": {
      "autoIncrement": true
    },
     "release-apk": {
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
